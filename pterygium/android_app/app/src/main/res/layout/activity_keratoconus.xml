<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_progress_background"
            android:text="RESEARCH DEMONSTRATION ONLY"
            android:textColor="@color/result_suspected"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/keratoconus_foundation_title"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/keratoconus_foundation_body"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/module_card_background"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Handheld positioning check"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Research demonstration only, not for testing patients. Use the main rear camera at 2x. The app compares ring-shape features with four labelled examples and checks photo quality. It cannot determine whether a person has keratoconus."
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/captureKeratoconusButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/button_primary_background"
                android:minHeight="52dp"
                android:text="Take photo and check position"
                android:textAllCaps="false"
                android:textColor="@color/on_primary"
                android:textStyle="bold" />

            <Button
                android:id="@+id/chooseKeratoconusButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/button_secondary_background"
                android:minHeight="52dp"
                android:text="Check a saved photo"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/module_card_background"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/choose_sample"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/sampleSpinner"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/button_secondary_background"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />

            <Button
                android:id="@+id/runSampleButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/button_primary_background"
                android:minHeight="52dp"
                android:text="@string/run_sample_test"
                android:textAllCaps="false"
                android:textColor="@color/on_primary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button android:id="@+id/savedKeratoconusCapturesButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="Saved photo captures" android:textAllCaps="false" />
        <Button android:id="@+id/generatePhoneMapsButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="52dp" android:enabled="false"
            android:text="Generate maps on this phone" android:textAllCaps="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="8dp" android:textSize="13sp" android:textColor="@color/text_secondary"
            android:text="Experimental maps for an original OnePlus 9R photo taken at 2x. Select a photo above first. Distances are assumed; this does not diagnose keratoconus." />
        <Button android:id="@+id/toggleAdvancedKeratoconusButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="Maps and calibration (optional)" android:textAllCaps="false" />
        <LinearLayout android:id="@+id/advancedKeratoconusControls" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <Button android:id="@+id/calibrationButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="52dp"
            android:text="Camera and attachment calibration" android:textAllCaps="false" />
        <TextView android:id="@+id/calibrationStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:padding="8dp"
            android:text="Calibration not measured. Ring detection is available." />
        <Button android:id="@+id/exportCaptureButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="52dp"
            android:text="Export capture for reconstruction" android:textAllCaps="false" android:enabled="false" />
        <Button android:id="@+id/importMapsButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="52dp"
            android:text="Open reconstructed maps" android:textAllCaps="false" android:enabled="false" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/keratoconusProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/datasetResultContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView android:id="@+id/positioningOverview"
                android:layout_width="match_parent" android:layout_height="260dp"
                android:contentDescription="Full photo with centre target and detected reflection centre"
                android:scaleType="fitCenter" android:visibility="gone" />
            <ImageView
                android:id="@+id/sampleImage"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:background="@drawable/module_card_background"
                android:contentDescription="@string/sample_image_description"
                android:padding="6dp"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/module_card_background"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/keratoconusResultText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/keratoconusMetricsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <Button android:id="@+id/retryPositionButton" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp"
                android:text="Take another photo" android:textAllCaps="false" />
            <LinearLayout
                android:id="@+id/mapsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/axial_map"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/axialMap"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/module_card_background"
                        android:contentDescription="@string/axial_map_description"
                        android:padding="4dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/tangential_map"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/tangentialMap"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/module_card_background"
                        android:contentDescription="@string/tangential_map_description"
                        android:padding="4dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="2dp"
                android:text="Research use only. Ring detection is calculated on this phone. Imported maps are calculated by the desktop reconstruction pipeline and linked to the source image. Neither is a clinical diagnosis."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:lineSpacingExtra="2dp"
            android:text="Sample tests use saved reference maps and measurements. Live tests run the shared Placido segmentation model on this phone and reject captures without enough complete rings."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/backToModulesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/button_secondary_background"
            android:minHeight="52dp"
            android:text="@string/back_to_modules"
            android:textAllCaps="false"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
